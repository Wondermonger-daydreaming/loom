{
  "compilerOptions": {
    "target": "ES2020", "module": "commonjs", "moduleResolution": "node",
    "strictNullChecks": true, "noImplicitAny": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": ["loom-companion/src/**/*.ts", "shared/**/*.ts"]
}
